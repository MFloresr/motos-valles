---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Formulario from '../components/Formulario.astro';
import Preguntas from '../components/Preguntas.astro';
import { getServicios } from '../lib/contenido';
import { euros } from '../lib/util';
import foto from '../assets/fotos/taller-herramientas.jpg';
import foto2 from '../assets/fotos/taller-mekanik.jpg';

const servicios = await getServicios();
const revisiones = [
  ['1.000 km o primera revisión', 'Aceite y filtro, apriete general, holguras de cables y cadena.'],
  ['Cada 6.000 a 10.000 km', 'Aceite y filtro, filtro de aire, frenos, neumáticos y líquidos.'],
  ['Cada 12.000 a 24.000 km', 'Bujías, ajuste de válvulas si lo pide el fabricante, líquido de frenos y refrigerante.'],
  ['Cada 2 años', 'Líquido de frenos y revisión de suspensiones, aunque no hayas hecho kilómetros.'],
];
const hoy = new Date().toISOString().slice(0, 10);
---

<Base titulo="Taller de motos" descripcion="Taller multimarca: revisiones, aceite, neumáticos, frenos, transmisión y diagnosis. Precio claro antes de empezar y cita online.">
  <div class="contenedor cabecera-pagina">
    <h1>Taller de motos</h1>
    <p>Te damos el precio antes de empezar y te avisamos si aparece algo más. Mantenimiento con los intervalos y recambios que pide el fabricante.</p>
  </div>

  <section class="seccion" style="padding-top:24px" aria-labelledby="t-servicios">
    <div class="contenedor">
      <div class="cabecera-seccion"><h2 id="t-servicios">Servicios y precios</h2><p>Precios con IVA, desde. Mano de obra y recambios básicos incluidos donde se indica.</p></div>
      <div class="servicios">
        {servicios.map((s) => (
          <article class="servicio">
            <h3>{s.data.nombre}</h3>
            <p>{s.data.descripcion}</p>
            <ul class="lista">{s.data.incluye.map((i) => <li>{i}</li>)}</ul>
            <div class="servicio__precio"><span class="gris">{s.data.duracion}</span><strong class="num">Desde {euros(s.data.desde)}</strong></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion--oscura" aria-labelledby="t-km">
    <div class="contenedor dos dos--desigual" style="align-items:start">
      <div>
        <h2 id="t-km">Qué toca y cuándo</h2>
        <p class="gris texto">Como guía general. Cada moto tiene su libro de mantenimiento, que manda sobre esta tabla.</p>
        <div class="tabla-envoltorio" style="color:var(--asfalto)">
          <table>
            <caption class="solo-lectores">Mantenimiento recomendado por kilómetros</caption>
            <thead><tr><th scope="col">Cuándo</th><th scope="col">Qué se revisa</th></tr></thead>
            <tbody>{revisiones.map(([a, b]) => <tr><th scope="row">{a}</th><td>{b}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
      <div class="foto-recta"><Image src={foto} alt="Mecánico agachado entre herramientas y piezas, inspeccionando una moto" widths={[500, 800]} sizes="(min-width: 900px) 40vw, 100vw" /></div>
    </div>
  </section>

  <section class="seccion" id="cita" aria-labelledby="t-cita">
    <div class="contenedor dos dos--desigual" style="align-items:start">
      <div>
        <h2 id="t-cita">Pide cita</h2>
        <p class="texto">Dinos qué necesita tu moto y cuándo te va bien. Te confirmamos la hora por teléfono o correo.</p>
        <div class="foto-recta" style="max-width:420px;margin-top:20px"><Image src={foto2} alt="Mecánico reparando una moto en un taller" widths={[400, 700]} sizes="420px" /></div>
      </div>
      <Formulario tipo="cita" boton="Pedir cita" mensajeOk="Cita solicitada. Te confirmamos la hora en el próximo día laborable.">
        <div><label for="c-nombre">Nombre <span class="marca" aria-hidden="true">*</span></label><input id="c-nombre" name="nombre" type="text" autocomplete="name" required /><p class="error" data-error-para="nombre"></p></div>
        <div><label for="c-tel">Teléfono <span class="marca" aria-hidden="true">*</span></label><input id="c-tel" name="telefono" type="tel" autocomplete="tel" required pattern="[0-9 +]{9,}" title="Escribe un teléfono de al menos 9 cifras" /><p class="error" data-error-para="telefono"></p></div>
        <div><label for="c-moto">Moto (marca y modelo) <span class="marca" aria-hidden="true">*</span></label><input id="c-moto" name="moto" type="text" required /><p class="error" data-error-para="moto"></p></div>
        <div><label for="c-km">Kilómetros</label><input id="c-km" name="km" type="number" min="0" inputmode="numeric" /></div>
        <div>
          <label for="c-servicio">Servicio</label>
          <select id="c-servicio" name="servicio">
            <option value="">No lo sé, que me aconsejéis</option>
            {servicios.map((s) => <option value={s.id}>{s.data.nombre}</option>)}
          </select>
        </div>
        <div><label for="c-fecha">Día que prefieres</label><input id="c-fecha" name="fecha" type="date" min={hoy} /></div>
        <div class="ancho-total"><label for="c-msg">¿Algo más que debamos saber?</label><textarea id="c-msg" name="mensaje"></textarea></div>
      </Formulario>
    </div>
  </section>

  <section class="seccion seccion--tiza"><div class="contenedor"><Preguntas tema="taller" titulo="Dudas sobre el taller" /></div></section>
</Base>

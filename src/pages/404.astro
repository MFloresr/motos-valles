---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noindex>
  <section class="seccion">
    <div class="contenedor" style="max-width:720px">
      <p><span class="placa placa--grande">404</span></p>
      <h1 style="font-size:clamp(2.6rem,6vw,4.4rem)">Esta carretera no lleva a ningún sitio.</h1>
      <p class="texto">La página que buscas no existe o se ha movido. Vuelve al inicio o mira las motos disponibles.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/">Ir al inicio</a><a class="btn btn--sec" href="/motos/">Ver motos nuevas</a></div>
    </div>
  </section>
</Base>
